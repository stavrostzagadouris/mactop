class CpuSampler:
    """Overall and per-core utilisation from Mach host_processor_info deltas."""

    def __init__(self):
        self.prev = self._read()

    @staticmethod
    def _read():
        if LIBC is None:
            return {}
        host = LIBC.mach_host_self()
        num_cpus = c_uint32(0)
        cpu_info = POINTER(c_int32)()
        msg_count = c_uint32(0)
        kr = LIBC.host_processor_info(
            host, PROCESSOR_CPU_LOAD_INFO, byref(num_cpus), byref(cpu_info), byref(msg_count)
        )
        if kr != 0 or not cpu_info:
            return {}
        out = {}
        try:
            n = num_cpus.value
            total_ints = msg_count.value
            arr = cast(cpu_info, POINTER(c_int32 * total_ints)).contents
            tot_idle = tot_all = 0
            for i in range(n):
                base = i * CPU_STATE_MAX
                user = arr[base + CPU_STATE_USER]
                sys_t = arr[base + CPU_STATE_SYSTEM]
                idle = arr[base + CPU_STATE_IDLE]
                nice = arr[base + CPU_STATE_NICE]
                all_t = user + sys_t + idle + nice
                out[i] = (idle, all_t)
                tot_idle += idle
                tot_all += all_t
            out["cpu"] = (tot_idle, tot_all)
        finally:
            LIBC.vm_deallocate(
                LIBC.mach_task_self(),
                cast(cpu_info, c_void_p).value or 0,
                c_ulong(msg_count.value * sizeof(c_int32)),
            )
        return out

    def sample(self):
        cur = self._read()

        def pct(key):
            if key not in self.prev or key not in cur:
                return 0.0
            d_idle = cur[key][0] - self.prev[key][0]
            d_total = cur[key][1] - self.prev[key][1]
            return clamp((d_total - d_idle) / d_total * 100.0) if d_total > 0 else 0.0

        total = pct("cpu")
        cores = sorted(k for k in cur if k != "cpu")
        per_core = [(idx, pct(idx)) for idx in cores]
        self.prev = cur
        return total, per_core


def get_cpu_name():
    brand = sysctl_str("machdep.cpu.brand_string")
    if brand:
        return brand
    return os.uname().machine or "Apple CPU"


def get_core_topology():
    """Returns (total_cores, p_cores, e_cores) when Apple Silicon topology sysctls exist."""
    total = os.cpu_count() or 1
    p_cores = sysctl_int("hw.perflevel0.logicalcpu")
    e_cores = sysctl_int("hw.perflevel1.logicalcpu")
    return total, p_cores, e_cores


def get_meminfo():
    tot = sysctl_int("hw.memsize", 1) or 1
    used = 0
    if LIBC is not None:
        host = LIBC.mach_host_self()
        page_sz = c_uint32(0)
        if LIBC.host_page_size(host, byref(page_sz)) != 0 or not page_sz.value:
            page_sz.value = sysctl_int("hw.pagesize", 4096) or 4096
        vm = VmStatistics64()
        cnt = c_uint32(sizeof(vm) // sizeof(c_int32))
        if LIBC.host_statistics64(host, HOST_VM_INFO64, byref(vm), byref(cnt)) == 0:
            # Activity Monitor style: App Memory (internal - purgeable) + Wired + Compressed
            app_pages = max(0, int(vm.internal_page_count) - int(vm.purgeable_count))
            if app_pages == 0:
                app_pages = max(0, int(vm.active_count) - int(vm.purgeable_count))
            used_pages = app_pages + int(vm.wire_count) + int(vm.compressor_page_count)
            used = min(tot, max(0, used_pages * page_sz.value))

    swap_tot = swap_used = 0
    if LIBC is not None:
        xsw = XswUsage()
        sz = c_size_t(sizeof(xsw))
        if LIBC.sysctlbyname(b"vm.swapusage", byref(xsw), byref(sz), None, 0) == 0:
            swap_tot = xsw.xsu_total
            swap_used = xsw.xsu_used

    return {
        "MemTotal": tot,
        "MemUsed": used,
        "SwapTotal": swap_tot,
        "SwapUsed": swap_used,
    }


