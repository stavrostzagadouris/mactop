class NetSampler:
    """Network throughput and total bytes across physical en* NICs via getifaddrs (handles 32-bit wrap)."""

    def __init__(self):
        self.prev_raw = {}
        self.accum_rx = 0
        self.accum_tx = 0
        self.label = ""
        self.sample()

    def sample(self):
        if LIBC is None:
            return 0, 0, ""
        ifap = POINTER(IfAddrs)()
        if LIBC.getifaddrs(byref(ifap)) != 0 or not ifap:
            return self.accum_rx, self.accum_tx, self.label

        phys_raw, all_raw = {}, {}
        try:
            cur = ifap
            while cur:
                ifa = cur.contents
                flags = ifa.ifa_flags
                if (flags & IFF_UP) and not (flags & IFF_LOOPBACK) and ifa.ifa_addr and ifa.ifa_data:
                    if ifa.ifa_addr.contents.sa_family == AF_LINK:
                        name = ifa.ifa_name.decode("utf-8", "replace") if ifa.ifa_name else ""
                        ifd = cast(ifa.ifa_data, POINTER(IfData)).contents
                        r, t = int(ifd.ifi_ibytes), int(ifd.ifi_obytes)
                        if r > 0 or t > 0:
                            all_raw[name] = (r, t)
                            # en* are physical Ethernet / Wi-Fi / Thunderbolt NICs on macOS;
                            # skip awdl/llw/utun/bridge/lo so traffic isn't double-counted.
                            if re.fullmatch(r"en\d+", name):
                                phys_raw[name] = (r, t)
                cur = ifa.ifa_next
        finally:
            LIBC.freeifaddrs(ifap)

        chosen = phys_raw if phys_raw else all_raw
        if not self.prev_raw:
            self.prev_raw = chosen
            self.accum_rx = sum(v[0] for v in chosen.values())
            self.accum_tx = sum(v[1] for v in chosen.values())
        else:
            for name, (r, t) in chosen.items():
                pr, pt = self.prev_raw.get(name, (r, t))
                dr = (r - pr) if r >= pr else (r + 0x100000000 - pr)
                dt = (t - pt) if t >= pt else (t + 0x100000000 - pt)
                self.accum_rx += dr
                self.accum_tx += dt
            self.prev_raw = chosen

        names = sorted(chosen.keys())
        self.label = names[0] if len(names) == 1 else f"{len(names)} adapters" if names else ""
        return self.accum_rx, self.accum_tx, self.label


