def get_uptime():
    if LIBC is None:
        return 0.0
    tv = TimeVal()
    sz = c_size_t(sizeof(tv))
    if LIBC.sysctlbyname(b"kern.boottime", byref(tv), byref(sz), None, 0) == 0 and tv.tv_sec > 0:
        return max(0.0, time.time() - tv.tv_sec)
    return 0.0


def ioreg_plist(class_name, depth=None, full=False):
    """full=True adds -l so child entries carry their properties too (not just the matched one)."""
    cmd = ["/usr/sbin/ioreg", "-a", "-r", "-c", class_name]
    if full:
        cmd.append("-l")
    if depth is not None:
        cmd.extend(["-d", str(depth)])
    try:
        out = subprocess.check_output(cmd, stderr=subprocess.DEVNULL, timeout=3)
        if not out.strip():
            return []
        data = plistlib.loads(out)
        if isinstance(data, dict):
            return [data]
        if isinstance(data, list):
            return data
    except Exception:
        pass
    return []


