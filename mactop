def _load_lib(names):
    if sys.platform != "darwin":
        return None
    for name in names:
        try:
            return CDLL(name, use_errno=True)
        except OSError:
            p = ctypes.util.find_library(name)
            if p:
                try:
                    return CDLL(p, use_errno=True)
                except OSError:
                    pass
    return None


