def cf_str(s):
    if CF is None:
        return None
    return CF.CFStringCreateWithCString(None, s.encode("utf-8"), kCFStringEncodingUTF8)


def from_cf_str(ref):
    if CF is None or not ref:
        return ""
    buf = create_string_buffer(256)
    if CF.CFStringGetCString(ref, buf, 256, kCFStringEncodingUTF8):
        return buf.value.decode("utf-8", "replace")
    return ""


class HidTempReader:
    """Reads Apple Silicon PMU / MTR die & GPU temperatures via IOHIDEventSystemClient (no sudo)."""

    kIOHIDEventTypeTemperature = 15
    kIOHIDEventFieldTemperatureLevel = 15 << 16

    def __init__(self):
        self.ok = False
        if IOKIT is None or CF is None:
            return
        try:
            IOKIT.IOHIDEventSystemClientCreate.argtypes = [c_void_p]
            IOKIT.IOHIDEventSystemClientCreate.restype = c_void_p
            IOKIT.IOHIDEventSystemClientSetMatching.argtypes = [c_void_p, c_void_p]
            IOKIT.IOHIDEventSystemClientSetMatching.restype = c_int
            IOKIT.IOHIDEventSystemClientCopyServices.argtypes = [c_void_p]
            IOKIT.IOHIDEventSystemClientCopyServices.restype = c_void_p
            IOKIT.IOHIDServiceClientCopyProperty.argtypes = [c_void_p, c_void_p]
            IOKIT.IOHIDServiceClientCopyProperty.restype = c_void_p
            IOKIT.IOHIDServiceClientCopyEvent.argtypes = [c_void_p, c_int64, c_int32, c_int64]
            IOKIT.IOHIDServiceClientCopyEvent.restype = c_void_p
            IOKIT.IOHIDEventGetFloatValue.argtypes = [c_void_p, c_int32]
            IOKIT.IOHIDEventGetFloatValue.restype = c_double
            self.ok = True
        except AttributeError:
            self.ok = False

    def read(self):
        """Returns (cpu_temp, gpu_temp, core_temps_dict)."""
        if not self.ok:
            return None, None, {}
        client = IOKIT.IOHIDEventSystemClientCreate(None)
        if not client:
            return None, None, {}
        k_page = cf_str("PrimaryUsagePage")
        k_usage = cf_str("PrimaryUsage")
        k_prod = cf_str("Product")
        v_page = c_int32(0xFF00)
        v_usage = c_int32(5)
        n_page = CF.CFNumberCreate(None, kCFNumberSInt32Type, byref(v_page))
        n_usage = CF.CFNumberCreate(None, kCFNumberSInt32Type, byref(v_usage))
        keys = (c_void_p * 2)(k_page, k_usage)
        vals = (c_void_p * 2)(n_page, n_usage)

        key_cb = c_void_p.in_dll(CF, "kCFTypeDictionaryKeyCallBacks")
        val_cb = c_void_p.in_dll(CF, "kCFTypeDictionaryValueCallBacks")
        match_dict = CF.CFDictionaryCreate(
            None, keys, vals, 2, byref(key_cb), byref(val_cb)
        )
        services = None
        cpu_temps, gpu_temps, soc_temps = [], [], []
        try:
            IOKIT.IOHIDEventSystemClientSetMatching(client, match_dict)
            services = IOKIT.IOHIDEventSystemClientCopyServices(client)
            if services:
                cnt = CF.CFArrayGetCount(services)
                for i in range(cnt):
                    srv = CF.CFArrayGetValueAtIndex(services, i)
                    if not srv:
                        continue
                    prod_ref = IOKIT.IOHIDServiceClientCopyProperty(srv, k_prod)
                    name = from_cf_str(prod_ref)
                    if prod_ref:
                        CF.CFRelease(prod_ref)
                    ev = IOKIT.IOHIDServiceClientCopyEvent(
                        srv, self.kIOHIDEventTypeTemperature, 0, 0
                    )
                    if not ev:
                        continue
                    t = float(IOKIT.IOHIDEventGetFloatValue(ev, self.kIOHIDEventFieldTemperatureLevel))
                    CF.CFRelease(ev)
                    if not (10.0 < t < 130.0):
                        continue
                    ln = name.lower()
                    if any(x in ln for x in ("pacc", "eacc", "tdie", "cpu")):
                        cpu_temps.append(t)
                    elif "gpu" in ln:
                        gpu_temps.append(t)
                    elif "soc" in ln or "pmu" in ln:
                        soc_temps.append(t)
        finally:
            for ref in (services, match_dict, n_page, n_usage, k_page, k_usage, k_prod, client):
                if ref:
                    CF.CFRelease(ref)

        cpu_t = (sum(cpu_temps) / len(cpu_temps)) if cpu_temps else (
            (sum(soc_temps) / len(soc_temps)) if soc_temps else None
        )
        gpu_t = (sum(gpu_temps) / len(gpu_temps)) if gpu_temps else None
        return cpu_t, gpu_t, {}


