def _base_disk(dev_path):
    """Maps /dev/disk3s1s1 or /dev/disk3s5 to its parent whole-disk identifier 'disk3'."""
    base = os.path.basename(dev_path)
    m = re.match(r"^(disk\d+)", base)
    return m.group(1) if m else base


def get_disks():
    if _getfsstat is None:
        return []
    cnt = _getfsstat(None, 0, MNT_NOWAIT)
    if cnt <= 0:
        return []
    buf = (StatFs * cnt)()
    res = _getfsstat(cast(buf, c_void_p), sizeof(buf), MNT_NOWAIT)
    if res <= 0:
        return []

    mounts = []
    for st in buf[:res]:
        dev = st.f_mntfromname.decode("utf-8", "replace")
        mnt = st.f_mntonname.decode("utf-8", "replace")
        fs = st.f_fstypename.decode("utf-8", "replace")
        flags = st.f_flags
        if not dev.startswith("/dev/disk") or fs in SKIP_FS:
            continue
        if mnt != "/" and mnt.startswith(SKIP_MOUNT_PREFIXES):
            continue
        if mnt != "/" and (flags & MNT_RDONLY):
            continue
        # Collapse macOS's firmlinked /System/Volumes/Data duplicate into "/"
        if mnt == "/System/Volumes/Data":
            continue
        if mnt != "/" and not mnt.startswith("/Volumes/") and (flags & MNT_DONTBROWSE):
            continue
        mounts.append((dev, mnt, st.f_blocks * st.f_bsize, st.f_bfree * st.f_bsize, st.f_bavail * st.f_bsize))

    mounts.sort(key=lambda m: (m[1] != "/", len(m[1])))
    seen_containers, disks = set(), []
    for dev, mnt, total, bfree, bavail in mounts:
        if total <= 0:
            continue
        # APFS volumes in the same container share pool capacity: deduplicate by container diskN
        container = _base_disk(dev)
        if container in seen_containers and mnt != "/":
            continue
        seen_containers.add(container)
        used = total - bavail
        pct = used / total * 100.0 if total else 0.0
        label = "/" if mnt == "/" else os.path.basename(mnt.rstrip("/")) or mnt
        disks.append({
            "mnt": label, "kname": container, "total": total, "used": used, "pct": clamp(pct),
        })
    disks.sort(key=lambda d: (d["mnt"] != "/", -d["total"]))
    return disks


def _find_bsd_names(node):
    names = []
    if isinstance(node, dict):
        b = node.get("BSD Name")
        if isinstance(b, str) and b.startswith("disk"):
            names.append(b)
        for ch in node.get("IORegistryEntryChildren", []) or []:
            names.extend(_find_bsd_names(ch))
    return names


_DRIVER_DISKS = {}   # IOBlockStorageDriver registry ID -> whole-disk names under it ("disk0", "disk3", ...)


def _driver_disk_map():
    """Child properties need `ioreg -l` (10x the output), so the driver -> disk map is cached
    and only rebuilt when the set of drivers changes (a disk was attached or ejected)."""
    out = {}
    for e in ioreg_plist("IOBlockStorageDriver", full=True):
        if isinstance(e, dict) and "IORegistryEntryID" in e:
            out[e["IORegistryEntryID"]] = sorted({_base_disk(b) for b in _find_bsd_names(e)})
    return out


def get_diskstats():
    """Returns read/write bytes for each disk device via IOBlockStorageDriver in IORegistry."""
    global _DRIVER_DISKS
    entries = [e for e in ioreg_plist("IOBlockStorageDriver") if isinstance(e, dict)]
    if not entries:
        return {}
    ids = {e.get("IORegistryEntryID") for e in entries}
    if not ids <= set(_DRIVER_DISKS):
        _DRIVER_DISKS = _driver_disk_map()
    out = {}
    tot_r = tot_w = 0
    for idx, e in enumerate(entries):
        stats = e.get("Statistics")
        if not isinstance(stats, dict):
            continue
        rd = int(stats.get("Bytes (Read)", 0) or 0)
        wr = int(stats.get("Bytes (Write)", 0) or 0)
        tot_r += rd
        tot_w += wr
        # A physical drive's APFS containers (disk0 -> disk3, ...) sit under the same driver,
        # so each whole-disk name gets that driver's bytes once.
        bases = _DRIVER_DISKS.get(e.get("IORegistryEntryID")) or []
        for base in bases:
            pr, pw = out.get(base, (0, 0))
            out[base] = (pr + rd, pw + wr)
        if not bases:
            out[f"driver{idx}"] = (rd, wr)
    out["__all__"] = (tot_r, tot_w)
    return out


