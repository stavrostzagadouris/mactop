class ProcSampler:
    def __init__(self):
        self.numer = 1
        self.denom = 1
        if LIBC is not None:
            tb = MachTimebaseInfo()
            if LIBC.mach_timebase_info(byref(tb)) == 0 and tb.denom > 0:
                self.numer, self.denom = tb.numer, tb.denom
        self.prev = {}
        self.names = {}
        self.prev_io = {}
        self.io_denied = set()
        self.prev_t = time.monotonic()
        self.sample(1, 1)

    @staticmethod
    def _list_pids():
        if LIBC is None:
            return []
        sz = LIBC.proc_listpids(PROC_ALL_PIDS, 0, None, 0)
        if sz <= 0:
            return []
        cnt = (sz // sizeof(c_int32)) + 32
        arr = (c_int32 * cnt)()
        actual = LIBC.proc_listpids(PROC_ALL_PIDS, 0, arr, sizeof(arr))
        if actual <= 0:
            return []
        n = actual // sizeof(c_int32)
        return sorted({int(arr[i]) for i in range(n) if arr[i] > 0})

    @staticmethod
    def _proc_name(pid, bsd):
        if LIBC is not None:
            pbuf = create_string_buffer(1024)
            plen = LIBC.proc_pidpath(pid, pbuf, 1024)
            if plen > 0:
                path = pbuf.value.decode("utf-8", "replace")
                base = os.path.basename(path)
                if base:
                    return base
        name = bsd.pbi_name.decode("utf-8", "replace").strip()
        if name:
            return name
        comm = bsd.pbi_comm.decode("utf-8", "replace").strip()
        return comm or f"pid-{pid}"

    def _ps_fallback(self, mem_total, cores, elapsed, cur, names, procs):
        """Fallback for processes belonging to other users where proc_pidinfo(TASKINFO) is restricted."""
        try:
            out = subprocess.check_output(
                ["/bin/ps", "-axo", "pid=,rss=,cputime=,comm="],
                stderr=subprocess.DEVNULL, text=True, timeout=2
            )
        except Exception:
            return
        seen = {p.pid for p in procs}
        for line in out.splitlines():
            parts = line.strip().split(None, 3)
            if len(parts) < 4:
                continue
            try:
                pid = int(parts[0])
                if pid <= 0 or pid in seen:
                    continue
                rss_bytes = int(parts[1]) * KB
            except ValueError:
                continue
            # Parse [dd-]hh:mm:ss.ff or mm:ss.ff into nanoseconds
            t_str = parts[2]
            days = 0
            if "-" in t_str:
                d_part, t_str = t_str.split("-", 1)
                days = int(d_part) if d_part.isdigit() else 0
            segs = t_str.split(":")
            try:
                secs = days * 86400.0 + sum(float(x) * (60.0 ** i) for i, x in enumerate(reversed(segs)))
            except ValueError:
                secs = 0.0
            ns = int(secs * 1e9)
            key = (pid, 0)
            cur[key] = ns
            cpu = 0.0
            if key in self.prev:
                cpu = max(0.0, (ns - self.prev[key]) / 1e9 / elapsed / cores * 100.0)
            name = os.path.basename(parts[3].strip()) or parts[3].strip()
            names[key] = name
            procs.append(Proc(pid, name, cpu, rss_bytes / MB, rss_bytes / mem_total * 100.0, None, None))

    def sample(self, mem_total, cores):
        now = time.monotonic()
        elapsed = max(1e-3, now - self.prev_t)
        cur, names, procs = {}, {}, []
        cur_io, denied = {}, set()
        pids = self._list_pids()

        bsd = ProcBsdInfo()
        bsd_sz = sizeof(bsd)
        ti = ProcTaskInfo()
        ti_sz = sizeof(ti)
        ru = RusageInfoV2()

        for pid in pids:
            has_bsd = LIBC.proc_pidinfo(pid, PROC_PIDTBSDINFO, 0, byref(bsd), bsd_sz) == bsd_sz
            has_ti = LIBC.proc_pidinfo(pid, PROC_PIDTASKINFO, 0, byref(ti), ti_sz) == ti_sz
            if not has_ti:
                continue
            start_sec = int(bsd.pbi_start_tvsec) if has_bsd else 0
            key = (pid, start_sec)

            raw_ticks = int(ti.pti_total_user) + int(ti.pti_total_system)
            ns = (raw_ticks * self.numer) // self.denom
            cur[key] = ns
            cpu = 0.0
            if key in self.prev:
                cpu = max(0.0, (ns - self.prev[key]) / 1e9 / elapsed / cores * 100.0)

            name = self.names.get(key)
            if not name:
                name = self._proc_name(pid, bsd) if has_bsd else f"pid-{pid}"
            names[key] = name

            rss = int(ti.pti_resident_size)
            threads = int(ti.pti_threadnum)
            io = None
            if key in self.io_denied:
                denied.add(key)
            else:
                if LIBC.proc_pid_rusage(pid, RUSAGE_INFO_V2, byref(ru)) == 0:
                    io_bytes = int(ru.ri_diskio_bytesread) + int(ru.ri_diskio_byteswritten)
                    cur_io[key] = io_bytes
                    io = max(0.0, (io_bytes - self.prev_io.get(key, io_bytes)) / elapsed)
                    # Prefer physical footprint when available (matches Activity Monitor memory column)
                    if ru.ri_phys_footprint > 0:
                        rss = int(ru.ri_phys_footprint)
                else:
                    denied.add(key)

            procs.append(Proc(pid, name, cpu, rss / MB, rss / mem_total * 100.0, threads, io))

        # Include other users' / root processes via fast ps fallback when running unprivileged
        self._ps_fallback(mem_total, cores, elapsed, cur, names, procs)

        self.prev, self.names, self.prev_t = cur, names, now
        self.prev_io, self.io_denied = cur_io, denied
        return procs, [p.pid for p in procs]


