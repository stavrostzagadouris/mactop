class SmcReader:
    """Direct user-space AppleSMC reader for fan RPM/%, Intel CPU/GPU temps and power."""

    KERNEL_INDEX_SMC = 2
    SMC_CMD_READ_BYTES = 5
    SMC_CMD_READ_KEYINFO = 9

    def __init__(self):
        self.conn = c_uint32(0)
        self.key_info_cache = {}
        if IOKIT is None or LIBC is None:
            return
        try:
            IOKIT.IOServiceMatching.argtypes = [c_char_p]
            IOKIT.IOServiceMatching.restype = c_void_p
            IOKIT.IOServiceGetMatchingService.argtypes = [c_uint32, c_void_p]
            IOKIT.IOServiceGetMatchingService.restype = c_uint32
            IOKIT.IOServiceOpen.argtypes = [c_uint32, c_uint32, c_uint32, POINTER(c_uint32)]
            IOKIT.IOServiceOpen.restype = c_int
            IOKIT.IOServiceClose.argtypes = [c_uint32]
            IOKIT.IOServiceClose.restype = c_int
            IOKIT.IOObjectRelease.argtypes = [c_uint32]
            IOKIT.IOObjectRelease.restype = c_int
            IOKIT.IOConnectCallStructMethod.argtypes = [
                c_uint32, c_uint32, c_void_p, c_size_t, c_void_p, POINTER(c_size_t)
            ]
            IOKIT.IOConnectCallStructMethod.restype = c_int

            srv = IOKIT.IOServiceGetMatchingService(0, IOKIT.IOServiceMatching(b"AppleSMC"))
            if srv:
                kr = IOKIT.IOServiceOpen(srv, LIBC.mach_task_self(), 0, byref(self.conn))
                IOKIT.IOObjectRelease(srv)
                if kr != 0:
                    self.conn = c_uint32(0)
        except Exception:
            self.conn = c_uint32(0)

    def close(self):
        if self.conn.value and IOKIT is not None:
            try:
                IOKIT.IOServiceClose(self.conn)
            except Exception:
                pass
            self.conn = c_uint32(0)

    def _call(self, inp, outp):
        out_sz = c_size_t(sizeof(SMCKeyData))
        return IOKIT.IOConnectCallStructMethod(
            self.conn, self.KERNEL_INDEX_SMC, byref(inp), sizeof(SMCKeyData),
            byref(outp), byref(out_sz)
        )

    def read_key(self, key):
        if not self.conn.value or len(key) != 4:
            return None
        k_int = struct.unpack(">I", key.encode("ascii"))[0]
        info = self.key_info_cache.get(k_int)
        if info is None:
            inp, outp = SMCKeyData(), SMCKeyData()
            inp.key = k_int
            inp.data8 = self.SMC_CMD_READ_KEYINFO
            if self._call(inp, outp) != 0 or outp.keyInfo.dataSize == 0:
                self.key_info_cache[k_int] = False
                return None
            info = (outp.keyInfo.dataSize, outp.keyInfo.dataType)
            self.key_info_cache[k_int] = info
        elif info is False:
            return None

        d_size, d_type = info
        inp, outp = SMCKeyData(), SMCKeyData()
        inp.key = k_int
        inp.keyInfo.dataSize = d_size
        inp.data8 = self.SMC_CMD_READ_BYTES
        if self._call(inp, outp) != 0:
            return None
        raw = bytes(outp.bytes[:d_size])
        t_str = struct.pack(">I", d_type).decode("ascii", "replace")
        if t_str == "flt " and d_size == 4:
            return struct.unpack("<f", raw)[0]
        if t_str == "sp78" and d_size == 2:
            return struct.unpack(">h", raw)[0] / 256.0
        if t_str == "fpe2" and d_size == 2:
            return struct.unpack(">H", raw)[0] / 4.0
        if t_str in ("ui8 ", "si8 ") and d_size == 1:
            return raw[0]
        if t_str == "ui16" and d_size == 2:
            return struct.unpack(">H", raw)[0]
        return None

    def read_fan_pct(self):
        if not self.conn.value:
            return None
        n_fans = self.read_key("FNum")
        if not n_fans or n_fans <= 0:
            return None
        pcts = []
        for i in range(min(4, int(n_fans))):
            ac = self.read_key(f"F{i}Ac")
            if ac is None:
                continue
            mx = self.read_key(f"F{i}Mx") or 5000.0
            mn = self.read_key(f"F{i}Mn") or 0.0
            if mx > mn and ac > 50:
                pcts.append(clamp((ac - mn) / (mx - mn) * 100.0))
            else:
                pcts.append(0.0)
        return max(pcts) if pcts else None

    def read_temps_and_power(self):
        """Fallback sensors (especially helpful on Intel Macs)."""
        if not self.conn.value:
            return None, None, None, None
        cpu_t = None
        for k in ("TC0P", "TC0D", "TC0E", "TC0F", "Tp09", "Tp01"):
            v = self.read_key(k)
            if v and 10.0 < v < 130.0:
                cpu_t = v
                break
        gpu_t = None
        for k in ("TG0P", "TG0D", "Tg05", "Tg0D"):
            v = self.read_key(k)
            if v and 10.0 < v < 130.0:
                gpu_t = v
                break
        cpu_w = self.read_key("PCPC") or self.read_key("PC0C")
        gpu_w = self.read_key("PCPG") or self.read_key("PG0R")
        if cpu_w is not None and not (0.0 <= cpu_w < 500.0):
            cpu_w = None
        if gpu_w is not None and not (0.0 <= gpu_w < 500.0):
            gpu_w = None
        return cpu_t, gpu_t, cpu_w, gpu_w


# ── Apple Silicon Power & Clocks via libIOReport (zero sudo) ─────────────────

def _read_pmgr_freqs():
    """Reads Apple Silicon CPU & GPU DVFS frequency tables (MHz) from pmgr in IORegistry."""
    if IOKIT is None or CF is None:
        return [], [], []
    try:
        IOKIT.IORegistryEntryFromPath.argtypes = [c_uint32, c_char_p]
        IOKIT.IORegistryEntryFromPath.restype = c_uint32
        IOKIT.IORegistryEntryCreateCFProperty.argtypes = [c_uint32, c_void_p, c_void_p, c_uint32]
        IOKIT.IORegistryEntryCreateCFProperty.restype = c_void_p
    except AttributeError:
        return [], [], []

    entry = 0
    for path in (b"IODeviceTree:/arm-io/pmgr", b"IODeviceTree:/arm-io@0/pmgr"):
        entry = IOKIT.IORegistryEntryFromPath(0, path)
        if entry:
            break
    if not entry:
        return [], [], []

    def parse_sram(prop):
        k = cf_str(prop)
        data_ref = IOKIT.IORegistryEntryCreateCFProperty(entry, k, None, 0)
        CF.CFRelease(k)
        if not data_ref:
            return []
        freqs = []
        try:
            length = CF.CFDataGetLength(data_ref)
            ptr = CF.CFDataGetBytePtr(data_ref)
            raw = ctypes.string_at(ptr, length)
            for i in range(0, len(raw) - 7, 8):
                hz = struct.unpack_from("<I", raw, i)[0]
                if 100_000_000 <= hz <= 6_000_000_000:
                    freqs.append(hz / 1e6)
                elif 100_000 <= hz <= 6_000_000:
                    freqs.append(hz / 1e3)
        finally:
            CF.CFRelease(data_ref)
        return freqs

    e_freqs = parse_sram("voltage-states1-sram")
    p_freqs = parse_sram("voltage-states5-sram")
    g_freqs = parse_sram("voltage-states9-sram") or parse_sram("voltage-states9")
    IOKIT.IOObjectRelease(entry)
    return e_freqs, p_freqs, g_freqs


class IOReportSampler:
    """Unprivileged libIOReport sampler for Apple Silicon CPU/GPU power (W) and clocks (MHz)."""

    def __init__(self):
        self.ok = False
        self.sub = None
        self.subbed = c_void_p()
        self.prev_sample = None
        self.prev_t = None
        self.energy_seen = set()   # "cpu"/"gpu" once their counter has moved (some macOS builds freeze CPU Energy)
        self.e_freqs, self.p_freqs, self.g_freqs = _read_pmgr_freqs()
        if IOREPORT is None or CF is None:
            return
        try:
            IOREPORT.IOReportCopyChannelsInGroup.argtypes = [c_void_p, c_void_p, c_uint64, c_uint64, c_uint64]
            IOREPORT.IOReportCopyChannelsInGroup.restype = c_void_p
            IOREPORT.IOReportMergeChannels.argtypes = [c_void_p, c_void_p, c_void_p]
            IOREPORT.IOReportMergeChannels.restype = None
            IOREPORT.IOReportCreateSubscription.argtypes = [
                c_void_p, c_void_p, POINTER(c_void_p), c_uint64, c_void_p
            ]
            IOREPORT.IOReportCreateSubscription.restype = c_void_p
            IOREPORT.IOReportCreateSamples.argtypes = [c_void_p, c_void_p, c_void_p]
            IOREPORT.IOReportCreateSamples.restype = c_void_p
            IOREPORT.IOReportCreateSamplesDelta.argtypes = [c_void_p, c_void_p, c_void_p]
            IOREPORT.IOReportCreateSamplesDelta.restype = c_void_p
            IOREPORT.IOReportChannelGetGroup.argtypes = [c_void_p]
            IOREPORT.IOReportChannelGetGroup.restype = c_void_p
            IOREPORT.IOReportChannelGetSubGroup.argtypes = [c_void_p]
            IOREPORT.IOReportChannelGetSubGroup.restype = c_void_p
            IOREPORT.IOReportChannelGetChannelName.argtypes = [c_void_p]
            IOREPORT.IOReportChannelGetChannelName.restype = c_void_p
            IOREPORT.IOReportChannelGetUnitLabel.argtypes = [c_void_p]
            IOREPORT.IOReportChannelGetUnitLabel.restype = c_void_p
            IOREPORT.IOReportSimpleGetIntegerValue.argtypes = [c_void_p, c_int32]
            IOREPORT.IOReportSimpleGetIntegerValue.restype = c_int64
            IOREPORT.IOReportStateGetCount.argtypes = [c_void_p]
            IOREPORT.IOReportStateGetCount.restype = c_int32
            IOREPORT.IOReportStateGetResidency.argtypes = [c_void_p, c_int32]
            IOREPORT.IOReportStateGetResidency.restype = c_int64
            IOREPORT.IOReportStateGetNameForIndex.argtypes = [c_void_p, c_int32]
            IOREPORT.IOReportStateGetNameForIndex.restype = c_void_p

            g_energy = cf_str("Energy Model")
            g_cpu = cf_str("CPU Stats")
            g_gpu = cf_str("GPU Stats")
            ch_e = IOREPORT.IOReportCopyChannelsInGroup(g_energy, None, 0, 0, 0)
            ch_c = IOREPORT.IOReportCopyChannelsInGroup(g_cpu, None, 0, 0, 0)
            ch_g = IOREPORT.IOReportCopyChannelsInGroup(g_gpu, None, 0, 0, 0)
            for s in (g_energy, g_cpu, g_gpu):
                if s:
                    CF.CFRelease(s)
            base = ch_e or ch_c or ch_g
            if not base:
                return
            for extra in (ch_c, ch_g):
                if extra and extra != base:
                    IOREPORT.IOReportMergeChannels(base, extra, None)
                    CF.CFRelease(extra)
            self.sub = IOREPORT.IOReportCreateSubscription(None, base, byref(self.subbed), 0, None)
            CF.CFRelease(base)
            if self.sub and self.subbed.value:
                self.prev_sample = IOREPORT.IOReportCreateSamples(self.sub, self.subbed, None)
                self.prev_t = time.monotonic()
                self.ok = bool(self.prev_sample)
        except Exception:
            self.ok = False

    def close(self):
        if CF is not None:
            for ref in (self.prev_sample, self.subbed.value, self.sub):
                if ref:
                    try:
                        CF.CFRelease(ref)
                    except Exception:
                        pass
        self.prev_sample = self.sub = None
        self.ok = False

    @staticmethod
    def _unit_scale(unit):
        u = unit.strip().lower()
        if u == "nj":
            return 1e-9
        if u in ("uj", "µj"):
            return 1e-6
        if u == "mj":
            return 1e-3
        if u == "j":
            return 1.0
        return 1e-3

    @staticmethod
    def _avg_freq(ch, table):
        """Residency-weighted MHz. The first state is IDLE/OFF; the active states that follow line up
        with the pmgr table in order (the GPU reports P1..P15 but only uses as many as the table has)."""
        cnt = IOREPORT.IOReportStateGetCount(ch)
        if cnt <= 0:
            return None
        active_ticks = 0
        weighted = 0.0
        rank = 0
        for idx in range(cnt):
            name = from_cf_str(IOREPORT.IOReportStateGetNameForIndex(ch, idx)).upper()
            if name in ("IDLE", "OFF", "DOWN", "INACTIVE"):
                continue
            res = IOREPORT.IOReportStateGetResidency(ch, idx)
            freq = table[rank] if rank < len(table) else None
            rank += 1
            if freq is None:
                m = re.search(r"(\d{3,4})\s*M", name)
                freq = float(m.group(1)) if m else None
            if freq and res > 0:
                weighted += freq * res
                active_ticks += res
        return (weighted / active_ticks) if active_ticks > 0 else None

    def sample(self):
        res = {"CpuPowerW": None, "GpuPowerW": None, "CpuClockMHz": None, "GpuClockMHz": None}
        if not self.ok or not self.sub:
            return res
        now = time.monotonic()
        cur = IOREPORT.IOReportCreateSamples(self.sub, self.subbed, None)
        if not cur:
            return res
        dt = now - (self.prev_t or now)
        if not self.prev_sample or dt <= 0.05:
            if self.prev_sample:
                CF.CFRelease(self.prev_sample)
            self.prev_sample, self.prev_t = cur, now
            return res

        delta = IOREPORT.IOReportCreateSamplesDelta(self.prev_sample, cur, None)
        CF.CFRelease(self.prev_sample)
        self.prev_sample, self.prev_t = cur, now
        if not delta:
            return res

        k_ch = cf_str("IOReportChannels")
        cpu_j = gpu_j = 0.0
        has_cpu_e = has_gpu_e = False
        cpu_clocks, gpu_clocks = [], []
        try:
            arr = CF.CFDictionaryGetValue(delta, k_ch)
            if arr:
                cnt = CF.CFArrayGetCount(arr)
                for i in range(cnt):
                    ch = CF.CFArrayGetValueAtIndex(arr, i)
                    if not ch:
                        continue
                    grp = from_cf_str(IOREPORT.IOReportChannelGetGroup(ch))
                    sub = from_cf_str(IOREPORT.IOReportChannelGetSubGroup(ch))
                    name = from_cf_str(IOREPORT.IOReportChannelGetChannelName(ch))
                    if grp == "Energy Model":
                        val = IOREPORT.IOReportSimpleGetIntegerValue(ch, 0)
                        if val < 0:
                            continue
                        unit = from_cf_str(IOREPORT.IOReportChannelGetUnitLabel(ch))
                        joules = val * self._unit_scale(unit)
                        ln = name.lower()
                        if "cpu energy" in ln:
                            cpu_j += joules
                            has_cpu_e = True
                        elif "gpu energy" in ln:
                            gpu_j += joules
                            has_gpu_e = True
                    elif grp == "CPU Stats" and "Performance States" in sub:
                        # "ECPU*" / "PCPU*" (note "ECPU" also contains a "P")
                        tbl = self.e_freqs if name.startswith("E") else (self.p_freqs if name.startswith("P") else [])
                        f = self._avg_freq(ch, tbl or self.p_freqs or self.e_freqs)
                        if f:
                            cpu_clocks.append(f)
                    elif grp == "GPU Stats" and "Performance States" in sub and name == "GPUPH":
                        f = self._avg_freq(ch, self.g_freqs)
                        if f:
                            gpu_clocks.append(f)
        finally:
            if k_ch:
                CF.CFRelease(k_ch)
            CF.CFRelease(delta)

        # An idle interval can read 0 J: keep showing 0.0W rather than flicking to N/A,
        # but never show a counter that has not moved since mactop started.
        if has_cpu_e and cpu_j > 0:
            self.energy_seen.add("cpu")
        if has_gpu_e and gpu_j > 0:
            self.energy_seen.add("gpu")
        has_cpu_e = has_cpu_e and "cpu" in self.energy_seen
        has_gpu_e = has_gpu_e and "gpu" in self.energy_seen
        if has_cpu_e:
            res["CpuPowerW"] = cpu_j / dt
        if has_gpu_e:
            res["GpuPowerW"] = gpu_j / dt
        if cpu_clocks:
            res["CpuClockMHz"] = max(cpu_clocks)
        if gpu_clocks:
            res["GpuClockMHz"] = int(round(max(gpu_clocks)))
        return res


class MacSensors:
    """Unified CPU & GPU sensor manager for Apple Silicon and Intel Macs."""

    def __init__(self):
        self.hid = HidTempReader()
        self.smc = SmcReader()
        self.ioreport = IOReportSampler()
        freq_hz = sysctl_int("hw.cpufrequency") or sysctl_int("hw.cpufrequency_max")
        self.sysctl_mhz = (freq_hz / 1e6) if freq_hz else None
        self.last = {
            "Temp": None, "Tag": "", "PowerW": None, "ClockMHz": self.sysctl_mhz,
            "CoreTemps": {}, "GpuTemp": None, "GpuPowerW": None,
            "GpuClockMHz": None, "FanPct": None,
        }

    def close(self):
        self.smc.close()
        self.ioreport.close()

    def sample(self):
        cpu_t, gpu_t, core_t = self.hid.read()
        smc_cpu_t, smc_gpu_t, smc_cpu_w, smc_gpu_w = self.smc.read_temps_and_power()
        fan_pct = self.smc.read_fan_pct()
        ior = self.ioreport.sample()

        self.last = {
            "Temp": cpu_t if cpu_t is not None else smc_cpu_t,
            "Tag": "",
            "PowerW": ior["CpuPowerW"] if ior["CpuPowerW"] is not None else smc_cpu_w,
            "ClockMHz": ior["CpuClockMHz"] if ior["CpuClockMHz"] is not None else self.sysctl_mhz,
            "CoreTemps": core_t,
            "GpuTemp": gpu_t if gpu_t is not None else smc_gpu_t,
            "GpuPowerW": ior["GpuPowerW"] if ior["GpuPowerW"] is not None else smc_gpu_w,
            "GpuClockMHz": ior["GpuClockMHz"],
            "FanPct": fan_pct,
        }
        return self.last


# ── GPU (IOAccelerator / AGXAccelerator via ioreg, no root) ──────────────────

def short_gpu_name(name):
    m = re.search(r"(Apple\s+M\d+(?:\s+(?:Pro|Max|Ultra))?|RX\s+\S+|Radeon\s+\S+|Iris\s+\S+|UHD\s+\S+)", name, re.I)
    if m:
        s = m.group(0)
        return re.sub(r"^Apple\s+", "", s, flags=re.I)
    s = re.sub(r"^(Apple|AMD|Intel|NVIDIA)\s+", "", name)
    s = re.sub(r"\s+Graphics", "", s).strip()
    return s or "GPU"


def new_gpu_stats(name="No GPU detected"):
    return {
        "Name": name, "ShortName": short_gpu_name(name), "Util": 0.0, "MemUtil": None,
        "MemUsedMB": 0.0, "MemTotMB": None, "Temp": None, "PowerW": None, "PowerCapW": None,
        "FanPct": None, "ClockCore": None, "ClockMem": None, "PState": "", "GpuPids": {},
        "UnifiedMem": False, "Cores": None,
    }


class MacGpu:
    """macOS GPU telemetry from IOAccelerator / AGXAccelerator in the IORegistry."""

    CREATOR_RE = re.compile(r"pid\s+(\d+)", re.I)

    def __init__(self, total_ram_bytes):
        self.total_ram_mb = total_ram_bytes / MB
        self.fallback_name = get_cpu_name() if "Apple" in (get_cpu_name() or "") else "Mac GPU"
        self.prev_clients = {}
        self.prev_t = None

    @classmethod
    def _extract_client_times(cls, node, out):
        if not isinstance(node, dict):
            return
        creator = node.get("IOUserClientCreator", "")
        if creator:
            m = cls.CREATOR_RE.search(str(creator))
            if m:
                pid = int(m.group(1))
                gpu_ns = 0
                app_usage = node.get("AppUsage")
                if isinstance(app_usage, list):
                    for item in app_usage:
                        if isinstance(item, dict):
                            gpu_ns += int(item.get("accumulatedGPUTime", 0) or 0)
                if gpu_ns == 0:
                    gpu_ns = int(node.get("accumulatedGPUTime", 0) or 0)
                out[pid] = out.get(pid, 0) + gpu_ns
        for child in node.get("IORegistryEntryChildren", []) or []:
            cls._extract_client_times(child, out)

    def sample(self, _pids, sens=None):
        entries = ioreg_plist("IOAccelerator", full=True)
        if not entries:
            return new_gpu_stats(self.fallback_name)

        # Pick the primary accelerator (prefer one with PerformanceStatistics and most cores/VRAM)
        best = entries[0]
        for e in entries:
            if isinstance(e, dict) and e.get("PerformanceStatistics"):
                best = e
                break

        perf = best.get("PerformanceStatistics") or {}
        model = (
            best.get("model")
            or best.get("IOGLBundleName")
            or perf.get("Device Name")
            or self.fallback_name
        )
        if isinstance(model, bytes):
            model = model.rstrip(b"\x00").decode("utf-8", "replace")
        model = str(model).strip() or self.fallback_name
        cores = best.get("gpu-core-count")
        if isinstance(cores, int) and cores > 0 and f"{cores}-Core" not in model:
            disp_name = f"{model} · {cores}-Core"
        else:
            disp_name = model

        res = new_gpu_stats(disp_name)
        res["ShortName"] = short_gpu_name(model)
        res["Cores"] = cores if isinstance(cores, int) else None

        util = (
            perf.get("Device Utilization %")
            if "Device Utilization %" in perf
            else perf.get("GPU Activity(%)")
        )
        if util is None:
            r_u = perf.get("Renderer Utilization %") or 0
            t_u = perf.get("Tiler Utilization %") or 0
            util = max(r_u, t_u)
        res["Util"] = clamp(float(util or 0.0))

        renderer = perf.get("Renderer Utilization %")
        tiler = perf.get("Tiler Utilization %")
        if renderer is not None:
            res["MemUtil"] = float(renderer)
        elif tiler is not None:
            res["MemUtil"] = float(tiler)

        # Memory: Dedicated VRAM (Intel/AMD dGPU) or Unified Memory in-use (Apple Silicon)
        vram_tot_mb = best.get("VRAM,totalMB") or perf.get("vramTotalMB")
        in_use_bytes = (
            perf.get("In use system memory")
            or perf.get("inUseSystemMemory")
            or perf.get("Alloc system memory")
            or perf.get("vramUsedBytes")
        )
        if vram_tot_mb:
            res["MemTotMB"] = float(vram_tot_mb)
            used_b = perf.get("vramUsedBytes") or in_use_bytes or 0
            res["MemUsedMB"] = float(used_b) / MB if used_b > 100000 else float(used_b)
        elif in_use_bytes is not None:
            res["UnifiedMem"] = True
            res["MemUsedMB"] = float(in_use_bytes) / MB
            res["MemTotMB"] = self.total_ram_mb

        # Merge sensors from MacSensors (IOReport / IOHID / SMC)
        if sens:
            res["Temp"] = sens.get("GpuTemp")
            res["PowerW"] = sens.get("GpuPowerW")
            res["ClockCore"] = sens.get("GpuClockMHz")
            res["FanPct"] = sens.get("FanPct")

        # Per-process GPU activity from IOUserClientCreator & accumulatedGPUTime
        now = time.monotonic()
        cur_clients = {}
        for e in entries:
            self._extract_client_times(e, cur_clients)

        dt_ns = (now - self.prev_t) * 1e9 if self.prev_t else None
        gpu_pids = {}
        for pid, tot_ns in cur_clients.items():
            if self.prev_t and pid in self.prev_clients and dt_ns and dt_ns > 0:
                d_ns = tot_ns - self.prev_clients[pid]
                if d_ns > 0:
                    pct = int(round(clamp(d_ns / dt_ns * 100.0)))
                    gpu_pids[pid] = max(1, pct)
                elif tot_ns > 0:
                    # Process holds an active Metal/GPU context that has submitted work
                    gpu_pids[pid] = 0
            elif tot_ns > 0:
                gpu_pids[pid] = 0

        self.prev_clients = cur_clients
        self.prev_t = now
        res["GpuPids"] = gpu_pids
        return res


# ── Battery / Network / Disks ────────────────────────────────────────────────

def get_battery():
    entries = ioreg_plist("AppleSmartBattery", depth=3)
    if not entries:
        return None
    b = entries[0]
    if not b.get("BatteryInstalled", True):
        return None
    cur = b.get("CurrentCapacity")
    mx = b.get("MaxCapacity")
    if not isinstance(cur, int) or not isinstance(mx, int) or mx <= 0:
        return None
    # On modern macOS CurrentCapacity is already 0-100 when MaxCapacity is 100;
    # otherwise compute the percentage from raw mAh.
    pct = cur if mx == 100 else int(round(cur / mx * 100.0))
    pct = int(clamp(pct, 0, 100))

    is_charging = bool(b.get("IsCharging"))
    ext_conn = bool(b.get("ExternalConnected"))
    if is_charging:
        status = "Charging"
    elif ext_conn:
        status = "Full"
    else:
        status = "Discharging"

    secs = None
    if status == "Discharging":
        tr = b.get("TimeRemaining")
        if isinstance(tr, int) and 0 < tr < 6000:
            secs = tr * 60
    return pct, status, secs


