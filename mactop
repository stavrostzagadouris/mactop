# ── sysctl helpers ───────────────────────────────────────────────────────────

def sysctl_str(name, default=None):
    if LIBC is None:
        return default
    bname = name.encode("utf-8")
    sz = c_size_t(0)
    if LIBC.sysctlbyname(bname, None, byref(sz), None, 0) != 0 or sz.value == 0:
        return default
    buf = create_string_buffer(sz.value)
    if LIBC.sysctlbyname(bname, buf, byref(sz), None, 0) != 0:
        return default
    return buf.value.decode("utf-8", "replace").strip() or default


def sysctl_int(name, default=None, signed=False):
    if LIBC is None:
        return default
    bname = name.encode("utf-8")
    val = c_int64(0) if signed else c_uint64(0)
    sz = c_size_t(8)
    if LIBC.sysctlbyname(bname, byref(val), byref(sz), None, 0) != 0:
        return default
    if sz.value == 4:
        raw = struct.pack("q" if signed else "Q", val.value)[:4]
        return struct.unpack("i" if signed else "I", raw)[0]
    return val.value


class TimeVal(Structure):
    _fields_ = [("tv_sec", c_long), ("tv_usec", c_int32), ("_pad", c_int32)]


class XswUsage(Structure):
    _fields_ = [
        ("xsu_total", c_uint64),
